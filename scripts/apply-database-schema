#!/usr/bin/env bash
# Re-apply idempotent FarmPi database schema migrations without loading demo data.
set -Eeuo pipefail

if [[ ${EUID} -ne 0 ]]; then
  echo "Run this helper through sudo." >&2
  exit 1
fi

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
schema_file=${project_dir}/config/database/schema.sql

for required_file in "${schema_file}"; do
  if [[ ! -f ${required_file} ]]; then
    echo "FarmPi database update file not found: ${required_file}" >&2
    exit 1
  fi
done

if ! systemctl is-active --quiet mariadb.service; then
  echo "MariaDB is not running; skipping schema update." >&2
  exit 1
fi

echo "Applying FarmPi database schema updates..."
mariadb --protocol=socket farmpi < "${schema_file}"

echo "Schema updated; existing operational data preserved."
