<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only. User-installed FarmPi/Caddy local CA certificates are
         deliberately trusted for farmpi.local; certificate verification stays on. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">farmpi.local</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
